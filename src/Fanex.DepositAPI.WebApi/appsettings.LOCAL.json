{
  "ConnectionStrings": {
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Http" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] : {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Http",
        "Args": {
          "requestUri": "http://10.18.200.193:31055",
          "queueLimitBytes": null,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] : {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Sentry": {
    "Dsn": "http://fd8fbf54524d478b9437a36ada3772ed@sentry.nexdev.net/185",
    "Enviroment": "LOCAL",
    "MaxBreadcrumbs": 50,
    "SendDefaultPii": true
  },
  "AppSetting": {
    "UseErrorHandler": true,
    "UseSwagger": true,
    "Enviroment": "LOCAL",
    "Version": "0.0.0.1"
  },
  "AllowedHosts": "*"
}
